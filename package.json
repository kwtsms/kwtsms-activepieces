{
  "name": "@kwtsms/piece-kwtsms",
  "version": "0.1.0",
  "description": "kwtSMS piece for Activepieces: send Arabic and English SMS through the kwtSMS gateway (Kuwait).",
  "main": "./dist/index.js",
  "files": [
    "dist/index.js",
    "dist/i18n",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "activepieces",
    "piece",
    "kwtsms",
    "sms",
    "kuwait",
    "otp"
  ],
  "homepage": "https://www.kwtsms.com/integrations.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwtsms/kwtsms-activepieces.git"
  },
  "bugs": {
    "url": "https://github.com/kwtsms/kwtsms-activepieces/issues"
  },
  "license": "MIT",
  "author": "kwtSMS",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.js && cp -r src/i18n dist/ 2>/dev/null; true",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@activepieces/pieces-framework": "0.32.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "@types/node": "^22.0.0",
    "@activepieces/shared": "0.95.1"
  }
}
